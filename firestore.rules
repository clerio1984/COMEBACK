rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'clerio1984@gmail.com' ||
        request.auth.token.email == 'admin@achei.mz' ||
        request.auth.token.email == 'admin@comeback.co.mz'
      );
    }

    // Collection Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    match /items/{itemId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /comments/{commentId} {
      allow read, write: if true;
    }

    match /dangerReports/{reportId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /insured_phones/{phoneId} {
      allow read, write: if true;
    }

    // Default safety deny net for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
